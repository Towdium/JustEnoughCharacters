{
  "_comment": "multiple-version line, MC 1.20.1 fabric. Two upstream pins had to be corrected for the modset to load at all. (1) fabric_api_version=0.76.0+1.19.4 (1.20.1/gradle.properties) is a known typo: no such file exists for 1.20.1 on CurseForge or Modrinth; substituted with the real 1.20.1 line 0.92.12+1.20.1. (2) fabric_loader_version=0.14.11 is likewise unloadable: the pinned jei 15.48.0.179 requires fabricloader >=0.16.3 and the substituted fabric-api 0.92.12+1.20.1 requires >=0.16.10, so Fabric refuses the set with 'Incompatible mod set!' before Minecraft starts. The loader is therefore raised to 0.16.14 (the version the 1.21.1 fabric row already runs). Revisit when upstream fixes its properties.",
  "name": "mv-1.20.1-fabric",
  "tags": [
    "mv",
    "fabric",
    "smoke",
    "experimental"
  ],
  "mc": "1.20.1",
  "loader": {
    "type": "fabric",
    "version": "0.16.14"
  },
  "java": {
    "version": 17
  },
  "jech": {
    "source": "local-build",
    "project": "multiple-version",
    "path": "1.20.1/fabric/build/libs/jecharacters-1.20.1-fabric-4.6.12.jar",
    "expectModId": "jecharacters"
  },
  "mods": [
    {
      "name": "jei",
      "source": "curseforge",
      "slug": "jei",
      "describe": {
        "version": "15.48.0.179"
      },
      "pin": {
        "fileId": 8576375,
        "filename": "jei-1.20.1-fabric-15.48.0.179.jar",
        "downloadUrl": "https://edge.forgecdn.net/files/8576/375/jei-1.20.1-fabric-15.48.0.179.jar",
        "sha1": "da286c9f6866ebab511bda95798893aafc9e5b74",
        "size": 1679861
      }
    },
    {
      "name": "fabric-api",
      "source": "curseforge",
      "slug": "fabric-api",
      "describe": {
        "version": "0.92.12+1.20.1"
      },
      "pin": {
        "fileId": 8784061,
        "filename": "fabric-api-0.92.12+1.20.1.jar",
        "downloadUrl": "https://edge.forgecdn.net/files/8784/61/fabric-api-0.92.12%2b1.20.1.jar",
        "sha1": "3e9cdd3e2f827ca9a259df9eb8e31949437b6bd4",
        "size": 2137232
      },
      "tags": [
        "experimental"
      ]
    }
  ],
  "checks": [
    {
      "type": "log_contains",
      "value": "Registering JEI pinyin search storage",
      "name": "jei-storage-registered"
    },
    {
      "type": "log_not_contains",
      "value": "Could not find targets.json. JechTransformer will not be loaded.",
      "name": "transformer-loaded"
    },
    {
      "type": "log_not_contains",
      "value": "Can't create config file!",
      "name": "config-writable"
    },
    {
      "type": "file_exists",
      "value": "config/jecharacters.json",
      "name": "config-generated"
    },
    {
      "type": "no_crash_reports",
      "name": "no-crash-reports"
    },
    {
      "type": "exit_code_zero",
      "name": "exit-code"
    }
  ],
  "ready_when": {
    "value": "Sound engine started"
  },
  "world": {
    "name": "jechworld"
  },
  "timeout_sec": 600,
  "jvm": {
    "max_mem_mb": 3072,
    "min_mem_mb": 1024,
    "window": [
      1280,
      720
    ]
  }
