{
  "_comment": "moderner line, MC 26.2, neoforge. jech.path points at the moderner checkout's neoforge-26.2 module built jar, and the row drives the standalone harness build uitest/moderner-26.2-neoforge (config->build->test).",
  "name": "moderner-26.2-neoforge",
  "tags": [
    "moderner",
    "neoforge",
    "smoke",
    "experimental"
  ],
  "mc": "26.2",
  "loader": {
    "type": "neoforge",
    "version": "26.2.0.93"
  },
  "java": {
    "version": 25
  },
  "uitest": {
    "selection": "tag:smoke,tag:jei",
    "project": "uitest/moderner-26.2-neoforge"
  },
  "jech": {
    "source": "local-build",
    "project": "moderner",
    "path": "neoforge-26.2/build/libs/jecharacters-26.2-neoforge-*.jar",
    "expectModId": "jecharacters",
    "via": "dev-classpath"
  },
  "mods": [
    {
      "name": "jei",
      "source": "curseforge",
      "slug": "jei",
      "via": "dev-classpath",
      "describe": {
        "version": "30.42.0.237"
      },
      "pin": {
        "fileId": 9205166,
        "filename": "jei-26.2-neoforge-30.42.0.237.jar",
        "downloadUrl": "https://edge.forgecdn.net/files/9205/166/jei-26.2-neoforge-30.42.0.237.jar",
        "sha1": "006316da5f88237dead0024281789f234e1562f8",
        "size": 2388069
      }
    }
  ],
  "checks": [
    {
      "type": "log_contains",
      "value": "Registering JEI pinyin search storage",
      "name": "jei-storage-registered"
    },
    {
      "type": "log_not_contains",
      "value": "Could not find targets.json. JechTransformer will not be loaded.",
      "name": "transformer-loaded"
    },
    {
      "type": "uitest_report",
      "name": "uitest-report"
    },
    {
      "type": "no_crash_reports",
      "name": "no-crash-reports"
    },
    {
      "type": "exit_code_zero",
      "name": "exit-code"
    }
  ],
  "world": null,
  "timeout_sec": 600
}
